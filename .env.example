SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=False
PORT=5000
MAIN_SITE_URL=https://YOUR_RENDER_BACKEND_URL
ADMIN_SITE_URL=https://YOUR_RENDER_ADMIN_URL
CORS_ALLOWED_ORIGINS=https://YOUR_RENDER_FRONTEND_URL
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=your_dedicated_application_database
MYSQL_SSL_MODE=REQUIRED
DB_AUTO_INIT=False
SESSION_COOKIE_SECURE=True
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=WHAT NEXT? Team
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=10
# Never use MySQL system schemas such as sys, mysql, information_schema, or performance_schema.
# Enable DB_AUTO_INIT only once, and only when MYSQL_DATABASE is a new empty application database.
# Set MYSQL_SSL_CA only when using VERIFY_CA or VERIFY_IDENTITY with a trusted CA file.
# MYSQL_SSL_CA=certs/ca.pem
